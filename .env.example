# --- Database (Supabase) ---
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# DATABASE_URL: "Transaction pooler" URL (port 6543) with ?pgbouncer=true
# DIRECT_URL:   "Session" / direct URL (port 5432), used for migrations
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/restaurant"

# --- Security ---
# Generate each with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
ENCRYPTION_KEY="change-me-to-another-long-random-string"

# --- App ---
NEXT_PUBLIC_APP_NAME="DineFlow"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Super admin (created by `npm run db:seed`) ---
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me"

# --- Platform (you, the SaaS owner) ---
# Your own Razorpay account: restaurants pay their subscription here.
PLATFORM_RAZORPAY_KEY_ID=""
PLATFORM_RAZORPAY_KEY_SECRET=""
# Printed on subscription invoices
PLATFORM_NAME="DineFlow"
PLATFORM_LEGAL_NAME=""
PLATFORM_GSTIN=""
PLATFORM_ADDRESS=""
PLATFORM_STATE="Maharashtra"
PLATFORM_SUPPORT_EMAIL=""
PLATFORM_SUPPORT_PHONE=""

# --- Scheduled jobs (birthday wishes, daily WhatsApp summary) ---
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""

# --- Optional: AI summary on the Insights page ---
ANTHROPIC_API_KEY=""
