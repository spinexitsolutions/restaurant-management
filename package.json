    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.14",
    "lucide-react": "^1.65.0",
    "next": "15.5.28",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "read-excel-file": "^9.3.14",
