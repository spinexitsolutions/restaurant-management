// Multi-tenant schema: every business record belongs to a Restaurant.
// Money is stored as Decimal(10,2) rupees; calculations happen in integer paise (see src/lib/gst.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  RESELLER
  OWNER
  MANAGER
  CASHIER
  WAITER
  CHEF
}

enum GstMode {
  INCLUSIVE
  EXCLUSIVE
}

enum FoodType {
  VEG
  NON_VEG
  EGG
}

enum TableStatus {
  FREE
  OCCUPIED
  BILL_PENDING
  CLEANING
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderSource {
  QR
  STAFF
}

// OPEN: taking orders -> BILLED: invoice generated, awaiting payment -> PAID: closed
enum OrderStatus {
  OPEN
  BILLED
  PAID
  CANCELLED
}

// PENDING_APPROVAL only for customer QR orders until staff accepts them
enum KotStatus {
  PENDING_APPROVAL
  ACCEPTED
  REJECTED
}

enum ItemStatus {
  NEW
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  RAZORPAY
  AGGREGATOR // settled later by Zomato / Swiggy
  OTHER
}

enum ServiceRequestType {
  CALL_WAITER
  REQUEST_BILL
  WATER
}

enum Plan {
  TRIAL
  BASIC
  PRO
}

// A brand that owns one or more outlets. Owners can switch between their organisation's outlets.
model Organization {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  restaurants Restaurant[]
  resellerId  String? // the partner who brought this customer
  reseller    Reseller?    @relation(fields: [resellerId], references: [id], onDelete: SetNull)
}

/// Sales partner / agent who refers restaurants and earns a share of their subscription payments.
model Reseller {
  id             String               @id @default(cuid())
  name           String
  phone          String
  email          String?
  code           String               @unique // referral code used in /signup?ref=CODE
  commissionRate Decimal              @default(20) @db.Decimal(5, 2) // % of the plan price before GST
  isActive       Boolean              @default(true)
  userId         String?              @unique // portal login
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  organizations  Organization[]
  commissions    ResellerCommission[]
  payouts        ResellerPayout[]
}

model ResellerCommission {
  id                    String              @id @default(cuid())
  resellerId            String
  reseller              Reseller            @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  subscriptionPaymentId String              @unique
  subscriptionPayment   SubscriptionPayment @relation(fields: [subscriptionPaymentId], references: [id], onDelete: Cascade)
  rate                  Decimal             @db.Decimal(5, 2)
  amount                Decimal             @db.Decimal(10, 2)
  createdAt             DateTime            @default(now())

  @@index([resellerId, createdAt])
}

model ResellerPayout {
  id         String   @id @default(cuid())
  resellerId String
  reseller   Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(10, 2)
  reference  String? // UTR / UPI reference
  note       String?
  createdAt  DateTime @default(now())

  @@index([resellerId, createdAt])
}

model Restaurant {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String       @unique
  phone          String?
  whatsappNumber String?
  email          String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  logoUrl        String?
  fssaiNumber    String?

  // GST
  gstEnabled           Boolean @default(true)
  gstin                String?
  gstMode              GstMode @default(EXCLUSIVE)
  defaultGstRate       Decimal @default(5) @db.Decimal(5, 2)
  serviceChargeEnabled Boolean @default(false)
  serviceChargeRate    Decimal @default(0) @db.Decimal(5, 2)
  invoicePrefix        String  @default("INV")
  nextInvoiceNumber    Int     @default(1)

  // Payments: Razorpay is used when keys are present, otherwise a plain UPI QR.
  upiId                    String?
  upiPayeeName             String?
  razorpayKeyId            String?
  razorpayKeySecretEnc     String? // AES-256-GCM encrypted, never sent to the client
  razorpayWebhookSecretEnc String?
  acceptCash               Boolean @default(true)
  acceptCard               Boolean @default(true)

  // Customer QR menu
  whatsappOrderingEnabled Boolean @default(true)
  qrOrderingEnabled       Boolean @default(true)
  menuThemeColor          String  @default("#ea580c")
  autoAcceptQrOrders      Boolean @default(false)

  // Cashiers/waiters need an owner or manager PIN for these when enabled
  requireManagerPin Boolean @default(true)

  // Loyalty: customers earn points on paid bills and redeem them as a discount
  loyaltyEnabled    Boolean @default(false)
  loyaltyEarnPer100 Decimal @default(2) @db.Decimal(6, 2) // points earned per ₹100 billed
  loyaltyPointValue Decimal @default(1) @db.Decimal(6, 2) // ₹ value of one point
  loyaltyMinRedeem  Int     @default(50)
  birthdayOfferText String  @default("Happy birthday {name}! 🎂 Enjoy 15% off at {restaurant} this week. Show this message when you visit.")

  reservationsEnabled Boolean @default(false) // public booking page

  // Dishes go "sold out" by themselves when an ingredient can't cover one more portion
  autoSoldOut  Boolean @default(true)
  // Hold later courses (mains, desserts) until a waiter fires them
  courseFiring Boolean @default(false)

  // Win-back: message customers who haven't visited for a while
  winbackEnabled      Boolean   @default(false)
  winbackDays         Int       @default(30)
  deletionScheduledAt DateTime? // owner asked to delete the account; purged by the daily job after this
  winbackOffer        String    @default("15% off your next visit")
  waWinbackTemplate   String? // {{1}} name, {{2}} restaurant, {{3}} offer

  // Aggregators: commission % used for reports (orders are punched in manually)
  zomatoCommission Decimal @default(25) @db.Decimal(5, 2)
  swiggyCommission Decimal @default(25) @db.Decimal(5, 2)

  // WhatsApp Business (Meta Cloud API). Template names must be approved in Meta Business Manager.
  waPhoneNumberId    String?
  waAccessTokenEnc   String?
  waTemplateLang     String  @default("en")
  waBillTemplate     String? // body params: {{1}} name, {{2}} restaurant, {{3}} amount, {{4}} bill link
  waBookingTemplate  String? // {{1}} name, {{2}} restaurant, {{3}} date & time, {{4}} guests
  waBirthdayTemplate String? // {{1}} name, {{2}} restaurant
  waSummaryTemplate  String? // {{1}} restaurant, {{2}} date, {{3}} sales, {{4}} bills

  // Daily counters (reset each day, IST) and financial-year invoice series
  orderSeqDate    String?
  nextOrderNumber Int     @default(1)
  nextKotNumber   Int     @default(1)
  invoiceSeqFy    String?

  // Bumped on every order/kitchen change; panels poll it to refresh in near real time.
  liveVersion Int @default(0)

  // SaaS subscription
  plan          Plan      @default(TRIAL)
  planExpiresAt DateTime?
  isActive      Boolean   @default(true)
  adminNote     String? // platform team's private notes (support, sales)

  // Counter / QSR mode: takeaway orders get a daily token number shown on a TV display
  tokenMode       Boolean @default(false)
  nextTokenNumber Int     @default(1)
  tokenSeqDate    String?
  displayKey      String  @unique @default(cuid()) // secret part of the public token display URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  categories           Category[]
  menuItems            MenuItem[]
  tables               DiningTable[]
  orders               Order[]
  kots                 Kot[]
  requests             ServiceRequest[]
  auditLogs            AuditLog[]
  dayCloses            DayClose[]
  images               Image[]
  ingredients          Ingredient[]
  subscriptionPayments SubscriptionPayment[]
  stations             KitchenStation[]
  coupons              Coupon[]
  printers             Printer[]
  printJobs            PrintJob[]
  whatsappMessages     WhatsAppMessage[]
  customers            Customer[]
  reservations         Reservation[]
  attendance           Attendance[]
}

model User {
  id                String             @id @default(cuid())
  restaurantId      String?
  restaurant        Restaurant?        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name              String
  email             String             @unique
  phone             String?
  passwordHash      String
  sessionVersion    Int                @default(0) // bumped on password reset: signs out every device
  language          String             @default("en") // en | hi | mr: staff screens and notifications
  pushSubscriptions PushSubscription[]
  reseller          Reseller?
  pinHash           String? // 4-6 digit approval PIN for owners and managers
  role              Role
  isActive          Boolean            @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  orders            Order[]            @relation("OrderWaiter")
  attendance        Attendance[]

  @@index([restaurantId])
}

model Category {
  id           String          @id @default(cuid())
  restaurantId String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  sortOrder    Int             @default(0)
  isActive     Boolean         @default(true)
  stationId    String?
  station      KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  course       Int             @default(0) // 0 none, 1 starter, 2 main, 3 dessert
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  items        MenuItem[]

  @@index([restaurantId, sortOrder])
}

model MenuItem {
  id              String          @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Decimal         @db.Decimal(10, 2)
  imageUrl        String?
  foodType        FoodType        @default(VEG)
  gstRate         Decimal?        @db.Decimal(5, 2) // null = restaurant default
  isAvailable     Boolean         @default(true)
  isBestseller    Boolean         @default(false)
  spiceLevel      Int             @default(0) // 0-3
  prepTimeMinutes Int?
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  variants        ItemVariant[]
  addonGroups     AddonGroup[]
  recipe          RecipeLine[]
  media           ItemMedia[]
  ratings         DishRating[]
  isKidsFriendly  Boolean         @default(false)
  autoSoldOut     Boolean         @default(false) // set by inventory, separate from the owner's isAvailable
  pairsWith       String[]        @default([]) // menu item ids suggested with this dish
  stationId       String? // overrides the category's station
  station         KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@index([restaurantId, categoryId])
}

// e.g. Half / Full. When an item has variants the variant price replaces the base price.
model ItemVariant {
  id         String       @id @default(cuid())
  menuItemId String
  menuItem   MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal      @db.Decimal(10, 2)
  sortOrder  Int          @default(0)
  recipe     RecipeLine[]

  @@index([menuItemId])
}

// e.g. "Extra toppings" with min/max selections.
model AddonGroup {
  id         String        @id @default(cuid())
  menuItemId String
  menuItem   MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  minSelect  Int           @default(0)
  maxSelect  Int           @default(1)
  sortOrder  Int           @default(0)
  options    AddonOption[]

  @@index([menuItemId])
}

model AddonOption {
  id           String     @id @default(cuid())
  addonGroupId String
  addonGroup   AddonGroup @relation(fields: [addonGroupId], references: [id], onDelete: Cascade)
  name         String
  price        Decimal    @default(0) @db.Decimal(10, 2)
  sortOrder    Int        @default(0)

  @@index([addonGroupId])
}

model DiningTable {
  id           String           @id @default(cuid())
  restaurantId String
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String // "T1", "Rooftop 4"
  area         String? // "AC Hall", "Rooftop"
  capacity     Int              @default(4)
  qrToken      String           @unique @default(cuid())
  status       TableStatus      @default(FREE)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  orders       Order[]
  requests     ServiceRequest[]
  reservations Reservation[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model Order {
  id            String       @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderNumber   Int // daily running number
  tokenNumber   Int? // counter token (QSR mode), daily
  publicToken   String       @unique @default(cuid()) // lets the customer track/pay without logging in
  type          OrderType    @default(DINE_IN)
  source        OrderSource  @default(STAFF)
  status        OrderStatus  @default(OPEN)
  tableId       String?
  table         DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableName     String? // snapshot, survives table rename/delete
  waiterId      String?
  waiter        User?        @relation("OrderWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  channel       String? // ZOMATO | SWIGGY for aggregator orders
  // B2B: buyer's GST details printed on the tax invoice
  buyerGstin    String?
  buyerName     String?
  buyerAddress  String?
  channelRef    String? // aggregator's order id
  customerName  String?
  customerPhone String?
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  note          String?

  // Loyalty
  pointsRedeemed    Int     @default(0) // applied as an extra flat discount
  pointsRedeemValue Decimal @default(0) @db.Decimal(10, 2) // ₹ value of those points, fixed when applied
  pointsDeducted    Boolean @default(false) // taken from the customer's balance at billing
  pointsEarned      Int     @default(0)

  discountType  String? // PERCENT | FLAT
  discountValue Decimal? @db.Decimal(10, 2) // percent, or rupees for FLAT
  discountNote  String?
  couponId      String?
  coupon        Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)

  // Frozen when the bill is generated
  invoiceNumber     String?
  gstEnabled        Boolean?
  gstMode           GstMode?
  serviceChargeRate Decimal? @db.Decimal(5, 2)
  subtotal          Decimal? @db.Decimal(10, 2)
  discountAmount    Decimal? @db.Decimal(10, 2)
  serviceCharge     Decimal? @db.Decimal(10, 2)
  cgst              Decimal? @db.Decimal(10, 2)
  sgst              Decimal? @db.Decimal(10, 2)
  roundOff          Decimal? @db.Decimal(10, 2)
  grandTotal        Decimal? @db.Decimal(10, 2)

  cancelReason String?
  billedAt     DateTime?
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items           OrderItem[]
  kots            Kot[]
  payments        Payment[]
  paymentRequests PaymentRequest[]

  @@unique([restaurantId, invoiceNumber])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([tableId, status])
}

// Kitchen Order Ticket: one batch of items sent to the kitchen together.
model Kot {
  id              String      @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kotNumber       Int
  clientRequestId String?     @unique // lets offline devices retry without creating duplicates
  status          KotStatus   @default(ACCEPTED)
  note            String?
  createdById     String? // null when placed by the customer
  createdAt       DateTime    @default(now())
  items           OrderItem[]

  @@index([restaurantId, status, createdAt])
  @@index([orderId])
}

model OrderItem {
  id            String     @id @default(cuid())
  orderId       String
  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kotId         String
  kot           Kot        @relation(fields: [kotId], references: [id], onDelete: Cascade)
  menuItemId    String?
  name          String
  variantName   String?
  addons        Json       @default("[]") // [{name, price}] in rupees
  foodType      FoodType   @default(VEG)
  unitPrice     Decimal    @db.Decimal(10, 2) // variant/base + add-ons
  quantity      Int
  gstRate       Decimal    @db.Decimal(5, 2)
  note          String?
  status        ItemStatus @default(NEW)
  stockDeducted Boolean    @default(false)
  stationId     String? // kitchen station when ordered
  course        Int        @default(0)
  held          Boolean    @default(false) // waiting to be fired
  firedAt       DateTime? // ingredients taken from inventory
  variantId     String?
  cancelReason  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([orderId])
  @@index([kotId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method            PaymentMethod
  amount            Decimal       @db.Decimal(10, 2)
  reference         String?
  razorpayOrderId   String?
  razorpayPaymentId String?       @unique
  clientRequestId   String?       @unique
  receivedById      String?
  createdAt         DateTime      @default(now())

  @@index([orderId])
}

model ServiceRequest {
  id           String             @id @default(cuid())
  restaurantId String
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId      String
  table        DiningTable        @relation(fields: [tableId], references: [id], onDelete: Cascade)
  type         ServiceRequestType
  resolvedAt   DateTime?
  createdAt    DateTime           @default(now())

  @@index([restaurantId, resolvedAt])
}

// Who did what to money: discounts, cancellations, reopened bills, table moves, day close.
model AuditLog {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String?
  userName     String?
  approvedBy   String? // name of the manager whose PIN approved it
  action       String
  orderId      String?
  orderNumber  Int?
  details      Json       @default("{}")
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

model DayClose {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  businessDate  String // IST yyyy-mm-dd
  openingCash   Decimal    @db.Decimal(10, 2)
  cashSales     Decimal    @db.Decimal(10, 2)
  upiSales      Decimal    @db.Decimal(10, 2)
  cardSales     Decimal    @db.Decimal(10, 2)
  onlineSales   Decimal    @db.Decimal(10, 2)
  otherSales    Decimal    @db.Decimal(10, 2)
  totalSales    Decimal    @db.Decimal(10, 2)
  cashWithdrawn Decimal    @default(0) @db.Decimal(10, 2)
  expectedCash  Decimal    @db.Decimal(10, 2)
  countedCash   Decimal    @db.Decimal(10, 2)
  difference    Decimal    @db.Decimal(10, 2)
  ordersCount   Int
  note          String?
  closedById    String?
  closedByName  String?
  createdAt     DateTime   @default(now())

  @@unique([restaurantId, businessDate])
}

// Menu photos and logos, stored in the database so uploads work on any host with no extra setup.
model Image {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  mime         String
  data         Bytes
  size         Int
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
}

// ---------- Inventory ----------

model Ingredient {
  id            String          @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  unit          String // kg, g, l, ml, pcs (recipes use the same unit)
  currentStock  Decimal         @default(0) @db.Decimal(14, 3)
  lowStockLevel Decimal         @default(0) @db.Decimal(14, 3)
  costPerUnit   Decimal         @default(0) @db.Decimal(12, 4) // weighted average purchase cost
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  recipeLines   RecipeLine[]
  movements     StockMovement[]

  @@unique([restaurantId, name])
}

// Ingredients used for one portion. variantId null = default recipe (used when a variant has none).
model RecipeLine {
  id           String       @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      ItemVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Decimal      @db.Decimal(12, 3)

  @@index([menuItemId])
}

enum StockMovementType {
  PURCHASE
  SALE
  SALE_RETURN
  WASTAGE
  ADJUSTMENT
}

model StockMovement {
  id           String            @id @default(cuid())
  restaurantId String
  ingredientId String
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  type         StockMovementType
  quantity     Decimal           @db.Decimal(14, 3) // + adds stock, - removes
  unitCost     Decimal?          @db.Decimal(12, 4)
  orderId      String?
  supplier     String?
  note         String?
  createdById  String?
  createdAt    DateTime          @default(now())

  @@index([restaurantId, createdAt])
  @@index([ingredientId, createdAt])
}

// ---------- CRM & loyalty ----------

model Customer {
  id                  String               @id @default(cuid())
  restaurantId        String
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  phone               String
  name                String?
  birthday            String? // MM-DD
  anniversary         String? // MM-DD
  notes               String?
  visits              Int                  @default(0)
  totalSpent          Decimal              @default(0) @db.Decimal(12, 2)
  points              Int                  @default(0)
  lastVisitAt         DateTime?
  gstin               String?
  businessName        String?
  businessAddress     String?
  lastWinbackAt       DateTime?
  marketingOptOut     Boolean              @default(false)
  lastBirthdayWish    Int? // year of the last automatic birthday message
  lastAnniversaryWish Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  orders              Order[]
  loyalty             LoyaltyTransaction[]
  reservations        Reservation[]

  @@unique([restaurantId, phone])
}

enum LoyaltyType {
  EARN
  REDEEM
  REFUND
  ADJUST
}

model LoyaltyTransaction {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String?
  type       LoyaltyType
  points     Int // + earned/refunded, - redeemed
  note       String?
  createdAt  DateTime    @default(now())

  @@index([customerId, createdAt])
}

// ---------- Reservations ----------

enum ReservationStatus {
  REQUESTED // from the public booking page, waiting for staff
  CONFIRMED
  SEATED
  CANCELLED
  NO_SHOW
}

model Reservation {
  id           String            @id @default(cuid())
  restaurantId String
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name         String
  phone        String
  partySize    Int
  startsAt     DateTime
  tableId      String?
  table        DiningTable?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  status       ReservationStatus @default(CONFIRMED)
  note         String?
  source       String            @default("STAFF") // STAFF | ONLINE
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([restaurantId, startsAt])
}

// ---------- Attendance ----------

model Attendance {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessDate String // IST yyyy-mm-dd of clock-in
  clockIn      DateTime
  clockOut     DateTime?
  note         String?

  @@index([restaurantId, businessDate])
  @@index([userId, clockIn])
}

// ---------- SaaS subscription (restaurants pay the platform) ----------

model SubscriptionPayment {
  id                String              @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  planCode          String // e.g. MONTHLY, YEARLY
  months            Int
  invoiceNumber     String              @unique
  amount            Decimal             @db.Decimal(10, 2) // before tax
  cgst              Decimal             @default(0) @db.Decimal(10, 2)
  sgst              Decimal             @default(0) @db.Decimal(10, 2)
  igst              Decimal             @default(0) @db.Decimal(10, 2)
  total             Decimal             @db.Decimal(10, 2)
  periodStart       DateTime
  periodEnd         DateTime
  razorpayOrderId   String?
  razorpayPaymentId String?             @unique
  method            String              @default("RAZORPAY") // RAZORPAY | MANUAL
  note              String?
  createdAt         DateTime            @default(now())
  commission        ResellerCommission?

  @@index([restaurantId, createdAt])
}

model PlatformCounter {
  key   String @id // e.g. "invoice:26-27"
  value Int
}

// ---------- WhatsApp automation log ----------

model WhatsAppMessage {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  to           String
  template     String
  kind         String // BILL | BOOKING | BIRTHDAY | ANNIVERSARY | SUMMARY
  status       String // SENT | FAILED
  error        String?
  providerId   String?
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

// ---------- Auth security ----------

// Failed and successful sign-in attempts, used to lock out password guessing.
model AuthAttempt {
  id        String   @id @default(cuid())
  key       String // "email:x@y.com", "ip:1.2.3.4", "otp:<userId>"
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// One-time codes for password reset and OTP login. Only a hash of the code is stored.
model OtpCode {
  id        String    @id @default(cuid())
  userId    String
  purpose   String // RESET | LOGIN
  codeHash  String
  channel   String // SMS | WHATSAPP | EMAIL | DEV
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ---------- Kitchen stations & printing ----------

model KitchenStation {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String // Tandoor, Chinese, Bar...
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  categories   Category[]
  items        MenuItem[]
  printers     Printer[]

  @@unique([restaurantId, name])
}

model Printer {
  id           String          @id @default(cuid())
  restaurantId String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  connection   String // BROWSER (print station page: system/USB/Bluetooth) | AGENT (LAN printer via print agent)
  address      String? // host:port for AGENT
  paperWidth   Int             @default(80) // 58 or 80 mm
  printKot     Boolean         @default(true)
  printBill    Boolean         @default(false)
  stationId    String? // KOTs only for this station; null = every item
  station      KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  agentToken   String          @unique @default(cuid())
  lastSeenAt   DateTime?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  jobs         PrintJob[]
}

model PrintJob {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  printerId    String
  printer      Printer    @relation(fields: [printerId], references: [id], onDelete: Cascade)
  kind         String // KOT | BILL | TEST
  title        String
  document     Json // receipt lines; rendered to ESC/POS or HTML by the printing device
  status       String     @default("PENDING") // PENDING | PRINTED | FAILED
  attempts     Int        @default(0)
  error        String?
  createdAt    DateTime   @default(now())
  printedAt    DateTime?

  @@index([printerId, status, createdAt])
}

// ---------- Menu media, ratings ----------

// Extra photos and one optional video for a dish, shown in the customer menu's detail view.
model ItemMedia {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  kind       String // IMAGE | VIDEO
  url        String
  sortOrder  Int      @default(0)

  @@index([menuItemId])
}

// A customer's 1-5 star rating of a dish from a paid order (one per dish per order).
model DishRating {
  id           String   @id @default(cuid())
  restaurantId String
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderId      String
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())

  @@unique([orderId, menuItemId])
  @@index([restaurantId, createdAt])
  @@index([menuItemId])
}

// A Razorpay dynamic UPI QR shown at the POS for one amount; paid status comes by webhook or polling.
model PaymentRequest {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  qrId      String    @unique
  amount    Decimal   @db.Decimal(10, 2)
  imageUrl  String
  status    String    @default("OPEN") // OPEN | PAID | CLOSED
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([orderId, status])
}

// ---------- Coupons ----------

model Coupon {
  id               String             @id @default(cuid())
  restaurantId     String
  restaurant       Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  code             String // stored upper-case
  description      String?
  type             String // PERCENT | FLAT
  value            Decimal            @db.Decimal(10, 2) // percent, or rupees for FLAT
  maxDiscount      Decimal?           @db.Decimal(10, 2) // cap for PERCENT coupons
  minBill          Decimal            @default(0) @db.Decimal(10, 2)
  validFrom        DateTime?
  validTo          DateTime?
  usageLimit       Int? // total uses
  perCustomerLimit Int? // needs the customer's mobile on the bill
  firstOrderOnly   Boolean            @default(false)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  orders           Order[]
  redemptions      CouponRedemption[]

  @@unique([restaurantId, code])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId    String   @unique
  customerId String?
  amount     Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  @@index([couponId, customerId])
}

// ---------- Web push ----------

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  endpoint     String   @unique
  p256dh       String
  auth         String
  createdAt    DateTime @default(now())

  @@index([restaurantId])
}
